# MADOVA server configuration. Copy to .env and fill in what you need —
# every value is optional, and the app runs without any of them.

# Signs session cookies. Set this in any real deployment: without it a random
# secret is generated per process, which signs everyone out on restart.
MADOVA_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Cloud phone API
# ---------------------------------------------------------------------------
# When set, device calls are forwarded to the upstream fleet instead of being
# served by this server's own engine. The key stays on the server — the browser
# never receives it.
MADOVA_UPSTREAM_KEY=
MADOVA_UPSTREAM_BASE=https://openapi.duoplus.net

# ---------------------------------------------------------------------------
# AI assistant — pick any provider
# ---------------------------------------------------------------------------
# Every supported provider speaks the OpenAI Chat Completions format, so one
# client covers all of them. Drop in a key and you are done: with no
# MADOVA_AI_PROVIDER set, the first provider below that has a key is used.
#
# Without any provider the assistant runs its deterministic intent router —
# device control and purchases still work, it just cannot converse.

OPENAI_API_KEY=            # OpenAI            → gpt-4o
GEMINI_API_KEY=            # Google Gemini     → gemini-2.0-flash
GROQ_API_KEY=              # Groq              → llama-3.3-70b-versatile
MISTRAL_API_KEY=           # Mistral           → mistral-large-latest
DEEPSEEK_API_KEY=          # DeepSeek          → deepseek-chat
TOGETHER_API_KEY=          # Together AI       → meta-llama/Llama-3.3-70B-Instruct-Turbo
XAI_API_KEY=               # xAI Grok          → grok-2-latest
OPENROUTER_API_KEY=        # OpenRouter        → openai/gpt-4o-mini

# Force a specific provider rather than auto-detecting. One of:
#   openai, google, groq, mistral, deepseek, together, xai, openrouter,
#   ollama, custom
# Note: ollama and custom are never auto-selected — name them here to use them.
MADOVA_AI_PROVIDER=

# Override the provider's default model. The defaults above are sensible but
# move over time, so set this explicitly for anything you depend on.
MADOVA_AI_MODEL=

# Local models via Ollama (MADOVA_AI_PROVIDER=ollama). Pick a model that
# supports tool calling, or the assistant drops to the intent router.
OLLAMA_BASE_URL=http://localhost:11434/v1

# Any other OpenAI-compatible endpoint — vLLM, LM Studio, a gateway, Azure.
# Set MADOVA_AI_PROVIDER=custom to use these.
MADOVA_AI_BASE_URL=
MADOVA_AI_API_KEY=

# ---------------------------------------------------------------------------
# Crypto checkout — USDT on BSC (BEP-20) and Tron (TRC-20)
# ---------------------------------------------------------------------------
# Your own receiving addresses. The server never holds a private key: it only
# watches the chain and confirms what arrived. Setting an address enables that
# network at checkout; leaving it blank hides it.
MADOVA_BSC_ADDRESS=
MADOVA_TRON_ADDRESS=

# Explorer access. BscScan/Etherscan works far better with a free API key;
# TronGrid works without one but is rate limited.
MADOVA_BSCSCAN_API_KEY=
MADOVA_TRONGRID_API_KEY=

# How settled a transfer must be before devices are provisioned.
MADOVA_BSC_CONFIRMATIONS=12
MADOVA_TRON_MIN_AGE_SEC=60

# How long an invoice's amount stays reserved.
MADOVA_PAYMENT_WINDOW_MIN=40

# Token contracts — defaults are the canonical USDT contracts. Verify them
# against your own source before taking money.
# MADOVA_BSC_USDT_CONTRACT=0x55d398326f99059fF775485246999027B3197955
# MADOVA_TRON_USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
# Where the JSON store is written. Defaults to ./data
MADOVA_DATA_DIR=

PORT=8787
