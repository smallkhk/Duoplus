# MADOVA server configuration. Copy to .env and fill in what you need —
# every value is optional, and the app runs without any of them.

# Signs session cookies. Set this in any real deployment: without it a random
# secret is generated per process, which signs everyone out on restart.
MADOVA_SESSION_SECRET=

# Cloud phone OpenAPI key. When set, device calls are forwarded to the upstream
# fleet instead of being served by this server's own engine. The key stays on
# the server — the browser never receives it.
MADOVA_UPSTREAM_KEY=
MADOVA_UPSTREAM_BASE=https://openapi.duoplus.net

# Claude credentials for the support assistant. Without one, the assistant runs
# its deterministic intent router: device control and purchases still work, but
# it cannot converse. See server/assistant.ts.
ANTHROPIC_API_KEY=
MADOVA_ASSISTANT_MODEL=claude-opus-5

# Where the JSON store is written. Defaults to ./data
MADOVA_DATA_DIR=

PORT=8787
